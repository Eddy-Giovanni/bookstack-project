# ============================================
# BookStack - Configuration Template
# ============================================
# Copiez ce fichier vers .env et modifiez les valeurs

# --- Application ---
APP_URL=https://localhost
APP_LANG=fr
APP_DEBUG=false

# --- Base de données ---
DB_HOST=database
DB_PORT=5432
DB_DATABASE=bookstack
DB_USERNAME=root
DB_PASSWORD=root

# --- Email (optionnel) ---
MAIL_DRIVER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password
MAIL_ENCRYPTION=tls
MAIL_FROM_NAME=BookStack
MAIL_FROM_ADDRESS=noreply@example.com

# --- Sécurité ---
APP_KEY=ChangeThisToARandom32CharacterString
# Générer avec: openssl rand -base64 32

# --- Utilisateurs créés au démarrage (voir README) ---
BOOKSTACK_SEED_USERS=true
BOOKSTACK_ADMIN_EMAIL=admin@admin.com
BOOKSTACK_ADMIN_PASSWORD=password
BOOKSTACK_ADMIN2_EMAIL=nguetsamiguel@gmail.com
BOOKSTACK_ADMIN2_PASSWORD=azerty12
BOOKSTACK_READER_EMAIL=lecteur@example.com
BOOKSTACK_READER_PASSWORD=qwerty
# En production AWS : BOOKSTACK_SEED_USERS=false et mots de passe forts via Secrets Manager

# --- AWS S3 (Backup) ---
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_DEFAULT_REGION=eu-west-3
AWS_S3_BUCKET=bookstack-backups

# --- HTTPS ---
NGINX_SERVER_NAME=localhost