# Dockerfile optimisé pour CI/CD
FROM lscr.io/linuxserver/bookstack:latest

# Métadonnées
LABEL maintainer="fomekongnguetsa@gmail.com"
LABEL version="1.0"
LABEL description="BookStack pour déploiement automatisé"

# Variables d'environnement par défaut
ENV APP_URL=https://localhost
ENV APP_LANG=fr

# Healthcheck
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost/login || exit 1

# Port exposé
EXPOSE 80
